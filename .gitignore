# .gitignore para rentify-ai

# 📁 Datos sensibles y pesados
data/raw/
data/clean/
data/embedded/
data/master/        

# 📁 Logs de ejecución
logs/
audit/
*.log

# 📁 Configuración privada
config/qdrant_settings.yaml
.env

# 📁 Exportaciones de flujos n8n (pueden contener credenciales)
flows/n8n/

# 📁 Archivos temporales o de sistema
*.tmp
*.bak
.DS_Store
Thumbs.db

# 🧪 Archivos de pruebas locales
__pycache__/
*.pyc
*.pyo
*.ipynb_checkpoints/

# 🧰 Entornos virtuales
venv/
.env/
.envrc
.venv/

#Token files
token.json
credentials.json
